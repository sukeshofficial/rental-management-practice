PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/rental-management
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Administrator Access Control
# Comma-separated list of email addresses that are treated as administrators.
# Any user who logs in with one of these emails gets full admin access (e.g., staff provisioning).
# NEVER commit real admin emails to version control. Keep this in your .env file only.
# Example: ADMIN_EMAILS=alice@rental.com,bob@rental.com
ADMIN_EMAILS=admin@rental.example

# Staff provisioning password secrets (used by create-staff.js with --file)
# Set each staff member's password as an env variable referenced in the template's 'passwordEnv' field.
# OPERATIONS_STAFF_PASSWORD=
# INVENTORY_MANAGER_PASSWORD=

# Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_key
SMTP_SECURE=false
EMAIL_FROM="Rental Management" <noreply@rentalmanagement.com>
# Optional service preset: gmail, sendgrid, ses (if set, overrides SMTP_HOST/SMTP_PORT)
# EMAIL_SERVICE=gmail

# F02 — Product Catalog & Search
# Minimum search query length for fuzzy typo matching (default: 4)
# SEARCH_MIN_FUZZY_LENGTH=4
# Maximum search query length accepted (default: 200)
# SEARCH_MAX_QUERY_LENGTH=200
# Default page size for product listing (default: 12)
# PRODUCT_DEFAULT_PAGE_SIZE=12
