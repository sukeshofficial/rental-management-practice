        "body": {
          "mode": "raw",
          "raw": "{\n  \"staff\": [\n    {\n      \"name\": \"Duplicate One\",\n      \"email\": \"duplicate@example.com\",\n      \"phone\": \"+91 98765 43213\",\n      \"role\": \"internal_staff\",\n      \"permissions\": [],\n      \"password\": \"TestStaff@12345\"\n    },\n    {\n      \"name\": \"Duplicate Two\",\n      \"email\": \"DUPLICATE@example.com\",\n      \"phone\": \"+91 98765 43214\",\n      \"role\": \"internal_staff\",\n      \"permissions\": [],\n      \"password\": \"TestStaff@12345\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/staff",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "staff"
          ]
        },
        "description": "Expected 400. Duplicate detection is case-insensitive and happens before database writes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
              "const json = pm.response.json();",
              "pm.test(\"Duplicate email rejected\", function () {",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.message).to.include(\"duplicate email in batch\");",
              "});"
            ]
          }
        }
      ]
    },
