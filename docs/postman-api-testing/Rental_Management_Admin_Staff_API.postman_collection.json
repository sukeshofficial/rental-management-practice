{
  "info": {
    "_postman_id": "6526013b-fd47-4f7e-99ef-b4c72777d718",
    "name": "Rental Management - Admin Staff Provisioning Tests",
    "description": "Tests POST /api/v1/admin/staff based on the supplied routes/controller/service. Set baseUrl and adminToken before running. The endpoint requires an authenticated active admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "REPLACE_WITH_ADMIN_JWT",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create staff (valid payload)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"staff\": [\n    {\n      \"name\": \"Postman Test Staff\",\n      \"email\": \"{{createdStaffEmail}}\",\n      \"phone\": \"+91 98765 43210\",\n      \"role\": \"internal_staff\",\n      \"permissions\": [\n        \"rental.read\",\n        \"inventory.read\"\n      ],\n      \"password\": \"TestStaff@12345\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/staff",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "staff"
          ]
        },
        "description": "Creates a new internal staff account. The pre-request script generates a unique email on each run."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = `postman.staff.${Date.now()}@example.com`;",
              "pm.collectionVariables.set(\"createdStaffEmail\", email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
              "const json = pm.response.json();",
              "pm.test(\"Provisioning succeeded and one account was created\", function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.created).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Reject unsupported role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"staff\": [\n    {\n      \"name\": \"Invalid Role Staff\",\n      \"email\": \"bad-role@example.com\",\n      \"phone\": \"+91 98765 43211\",\n      \"role\": \"admin\",\n      \"permissions\": [],\n      \"password\": \"TestStaff@12345\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/staff",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "staff"
          ]
        },
        "description": "Expected 400. If USER_ROLES.INTERNAL_STAFF in your user model uses a different literal value, update the role in this request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
              "const json = pm.response.json();",
              "pm.test(\"Unsupported role rejected\", function () {",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.message).to.include(\"unsupported or unauthorized staff role\");",
              "});"
            ]
          }
        }
      ]
    },
