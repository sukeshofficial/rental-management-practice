  "item": [
    {
      "name": "01 - Get categories (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "categories"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Categories returned\",()=>{pm.response.to.have.status(200);let j=pm.response.json();pm.expect(j.success).eql(true);pm.expect(j.categories).to.be.an(\"array\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create product (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{productName}}\",\n  \"sku\": \"{{productSku}}\",\n  \"description\": \"Postman product API test\",\n  \"category\": \"Cameras & Accessories\",\n  \"color\": \"Black\",\n  \"images\": [\n    {\n      \"url\": \"https://example.com/postman-camera.jpg\",\n      \"alt\": \"Test camera\",\n      \"sortOrder\": 0\n    }\n  ],\n  \"keywords\": [\n    \"camera\",\n    \"photography\",\n    \"mirrorless\"\n  ],\n  \"isRentable\": true,\n  \"basePrice\": 25000,\n  \"currency\": \"INR\",\n  \"pricingRules\": [\n    {\n      \"duration\": \"1 Day\",\n      \"pricelist\": \"Standard\",\n      \"price\": 1200,\n      \"isActive\": true\n    },\n    {\n      \"duration\": \"1 Week\",\n      \"pricelist\": \"Premium\",\n      \"price\": 6500,\n      \"isActive\": true\n    }\n  ],\n  \"reservationCharges\": {\n    \"extraHour\": 100,\n    \"extraDay\": 500,\n    \"additionalCharge\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp=Date.now();pm.collectionVariables.set(\"productName\",`Postman Test Camera ${stamp}`);pm.collectionVariables.set(\"productSku\",`POSTMAN-CAM-${stamp}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created product and saved identifiers\",()=>{pm.response.to.have.status(201);let j=pm.response.json();pm.expect(j.success).eql(true);pm.expect(j.product.status).eql(\"active\");pm.collectionVariables.set(\"productId\",j.product.id||j.product._id);pm.collectionVariables.set(\"productSlug\",j.product.slug);});"
            ]
          }
        }
      ]
    },
